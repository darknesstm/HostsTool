<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- enable usage of System.Windows.Forms.NotifyIcon -->
        <UseWindowsForms>true</UseWindowsForms>
        <!-- Use the generated high-resolution icon as the application icon -->
        <ApplicationIcon>Resources\hosts_icon.ico</ApplicationIcon>
        <Win32Icon>Resources\hosts_icon.ico</Win32Icon>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Resources\Hosts.xshd" />
    </ItemGroup>
    <ItemGroup>
        <Resource Include="Resources\Hosts.xshd" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Resources\hosts_icon.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
