<Window x:Class="HostsTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HostsTool"
        mc:Ignorable="d"
        Title="HostsTool" Height="450" Width="800">
    <Window.Resources>
        <!-- Simple ToggleSwitch style using ToggleButton -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="SwitchBorder" CornerRadius="11" Background="#DDD" Width="48" Height="22">
                            <Grid>
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" Margin="2" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list with an IsActive ToggleSwitch per item -->
        <StackPanel Grid.Column="0" Margin="8">
            <!-- Removed top toolbar; per-item actions now inline at the right side of each row -->
            <ListView ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      Name="EntriesList"
                      PreviewMouseLeftButtonDown="EntriesList_PreviewMouseLeftButtonDown">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <DockPanel LastChildFill="True" Margin="2">
                            <!-- Context menu must be declared before child content -->
                            <DockPanel.ContextMenu>
                                <ContextMenu Opened="RowContextMenu_Opened">
                                    <MenuItem Header="Rename" Click="RenameEntry_Click"/>
                                    <MenuItem Header="Delete" Click="DeleteEntry_Click"/>
                                </ContextMenu>
                            </DockPanel.ContextMenu>

                            <!-- Right-aligned actions: Rename and Delete (icon buttons) -->
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Rename" Click="RenameEntry_Click" IsEnabled="{Binding IsEditable}">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Delete" Click="DeleteEntry_Click" IsEnabled="{Binding IsEditable}">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding IsActive, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="4"
                                          IsEnabled="{Binding IsEditable}"/>

                            <!-- Title display: non-editable; rename via button only -->
                            <TextBlock Text="{Binding Title}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,4,0"/>

                        </DockPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Bottom add row styled like a list row -->
            <Border Margin="2" Padding="6" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                <Button Click="AddEntry_Click" Padding="6,2" HorizontalAlignment="Left" Width="32" Height="28">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </Border>
        </StackPanel>

        <!-- Column splitter for resizable panes -->
        <GridSplitter Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="5" Background="#EEE" ShowsPreview="True"/>

        <!-- Right: editable textbox bound to the selected item's Content -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Details:" FontWeight="Bold" Margin="4"/>

            <!-- Custom syntax highlighting RichTextBox -->
            <local:HostsSyntaxTextBox x:Name="HostsEditor" Grid.Row="1"
                                      Text="{Binding SelectedEntry.Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsReadOnly="{Binding SelectedEntry.IsReadOnly}"
                                      Margin="4"/>
        </Grid>
    </Grid>
</Window>
